<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only network policy: permit cleartext (HTTP) to ANY host so the app can
    reach the local Supabase stack no matter how a developer connects:
      - emulator        -> http://10.0.2.2:54321   (the default SUPABASE_URL)
      - physical device -> http://<host-LAN-IP>:54321  (set SUPABASE_URL in local.properties)

    This file overrides src/main/res/xml/network_security_config.xml in debug
    builds only; release builds keep the strict HTTPS-only policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
