<?xml version="1.0" encoding="utf-8"?>
<!--
    Permits cleartext (HTTP) traffic ONLY to the local Supabase stack during
    development. The emulator reaches the host machine at 10.0.2.2; 127.0.0.1 /
    localhost cover physical-device port-forwarding and host-run tooling.
    All other domains remain HTTPS-only, so release builds are unaffected.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
