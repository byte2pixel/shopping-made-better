    <string name="history_filter_date_desc">%1$s, filter by date</string>
    <string name="history_filter_date_selected_desc">%1$s, filtering by date</string>
    <string name="history_filter_date_apply">Apply</string>
    <string name="history_filter_date_cancel">Cancel</string>
